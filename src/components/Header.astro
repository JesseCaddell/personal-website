---
const links = [
  { href: "#about", label: "[01] About" },
  { href: "#projects", label: "[02] Projects" },
  { href: "#resume", label: "[03] Resume" },
];
---

<header class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
  <a href="/" class="flex items-center gap-3">
    <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
    <span class="text-base font-bold">jesse caddell</span>
    <span class="text-xs text-muted">// dev.profile</span>
  </a>
  <nav class="flex items-center gap-8 text-sm">
    {links.map(({ href, label }, i) => (
      <a
        href={href}
        class:list={[
          "transition-colors hover:text-fg",
          i === 0 ? "text-fg" : "text-muted",
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
</header>
