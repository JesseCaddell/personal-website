---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Projects — Jesse Caddell"
  description="All projects built by Jesse Caddell."
>
  <div class="mx-auto max-w-[1440px] px-6 pt-16 md:px-20">
    <Header />
    <section class="mt-12 flex flex-col gap-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold">// all projects</h2>
        <p class="text-xs text-muted">{projects.length} records loaded</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {projects.map((p) => (
          <ProjectCard
            slug={p.id}
            index={String(p.data.order).padStart(2, "0")}
            tag={p.data.tag}
            status={p.data.status}
            name={p.data.name}
            description={p.data.description}
          />
        ))}
      </div>
      <a
        href="/"
        class="self-start text-xs text-muted transition-colors hover:text-accent"
      >
        ← Back home
      </a>
    </section>
    <Footer class="mt-12 mb-16" />
  </div>
</Layout>
