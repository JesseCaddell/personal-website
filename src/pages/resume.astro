---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Resume — Jesse Caddell"
  description="Download Jesse Caddell's resume (PDF)."
>
  <div class="mx-auto max-w-[1440px] px-6 pt-16 md:px-20">
    <Header />
    <section class="mt-12 flex flex-col gap-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-lg font-bold">// resume</h2>
        <a
          href="/jesse-caddell-resume.pdf"
          download="jesse-caddell-resume.pdf"
          class="text-xs font-semibold text-accent transition-colors hover:underline"
        >
          Download PDF ↓
        </a>
      </div>
      <div class="h-[85vh] min-h-[700px] overflow-hidden rounded-md border border-line bg-surface">
        <embed
          src="/jesse-caddell-resume.pdf"
          type="application/pdf"
          class="h-full w-full"
        />
      </div>
      <a
        href="/"
        class="self-start text-xs text-muted transition-colors hover:text-accent"
      >
        ← Back home
      </a>
    </section>
    <Footer class="mt-12 mb-16" />
  </div>
</Layout>
