---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="The Midgar Gospel — Coming Soon"
  description="TheMidgarGospel, Jesse Caddell's retro web-shrine — coming soon."
>
  <div class="midgar-theme flex min-h-screen flex-col items-center justify-center gap-8 px-6 py-16 text-center">
    <div class="flex items-center gap-3">
      <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
      <span class="text-sm font-bold">the midgar gospel</span>
      <span class="text-xs text-muted">// web.shrine</span>
    </div>

    <div class="flex w-full max-w-[480px] flex-col gap-6 rounded-md border border-line bg-surface p-8">
      <div class="flex items-center justify-between text-[11px]">
        <span class="text-accent">sys_status: BUILDING</span>
        <span class="text-muted">0x4D47</span>
      </div>

      <div class="flex w-full items-center justify-center">
        <img
          src="/lif.gif"
          alt="Animated pixel-art sprite"
          width="189"
          height="207"
          class="[image-rendering:pixelated]"
        />
      </div>
    </div>

    <a href="/" class="text-xs text-muted transition-colors hover:text-accent">
      ← back to // dev.profile
    </a>
  </div>
</Layout>

<style>
  .midgar-theme {
    --color-accent: #b026ff;
    --color-accent-bg: #241530;
    --color-accent-line: #4a1f73;
  }
</style>
